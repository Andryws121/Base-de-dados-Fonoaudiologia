@page
@model RegisterModel
@{
    ViewData["Title"] = "Criar Conta";
}

<div class="container mt-5 pt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <div class="bg-success-subtle text-success d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 60px; height: 60px;">
                            <i class="bi bi-person-plus fs-2"></i>
                        </div>
                        <h3 class="fw-bold text-body-emphasis">Criar nova conta</h3>
                        <p class="text-muted small">Junte-se ao Workspace Clínico</p>
                    </div>

                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>
                        
                        <!-- NOVO CAMPO: Nome Completo -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.NomeCompleto" class="form-control border-secondary-subtle" aria-required="true" placeholder="Seu nome" />
                            <label asp-for="Input.NomeCompleto">Nome Completo</label>
                            <span asp-validation-for="Input.NomeCompleto" class="text-danger small"></span>
                        </div>

                       <!-- E-mail corrigido -->
<div class="form-floating mb-3">
    <input asp-for="Input.Email" class="form-control border-secondary-subtle" autocomplete="username" aria-required="true" placeholder="E-mail" />
    <label asp-for="Input.Email"></label>
    <span asp-validation-for="Input.Email" class="text-danger small"></span>
</div>

<!-- Senha de acesso com botão de olho -->
<div class="input-group mb-3 shadow-sm rounded">
    <div class="form-floating flex-grow-1">
        <input asp-for="Input.Password" type="password" class="form-control border-secondary-subtle border-end-0" style="border-top-right-radius: 0; border-bottom-right-radius: 0;" autocomplete="new-password" aria-required="true" placeholder="Senha" id="senhaInput" />
        <label asp-for="Input.Password"></label>
    </div>
    <button class="btn btn-outline-secondary border-secondary-subtle bg-white" type="button" id="btnToggleSenha" style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
        <i class="bi bi-eye text-secondary" id="iconSenha"></i>
    </button>
</div>
<span asp-validation-for="Input.Password" class="text-danger small mb-3 d-block mt-n2"></span>

<!-- Confirmar senha com botão de olho -->
<div class="input-group mb-4 shadow-sm rounded">
    <div class="form-floating flex-grow-1">
        <input asp-for="Input.ConfirmPassword" type="password" class="form-control border-secondary-subtle border-end-0" style="border-top-right-radius: 0; border-bottom-right-radius: 0;" autocomplete="new-password" aria-required="true" placeholder="Confirme a senha" id="confirmaSenhaInput" />
        <label asp-for="Input.ConfirmPassword"></label>
    </div>
    <button class="btn btn-outline-secondary border-secondary-subtle bg-white" type="button" id="btnToggleConfirma" style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
        <i class="bi bi-eye text-secondary" id="iconConfirma"></i>
    </button>
</div>
<span asp-validation-for="Input.ConfirmPassword" class="text-danger small mb-4 d-block mt-n2"></span>
                        
                        <button id="registerSubmit" type="submit" class="btn btn-dark w-100 py-3 fw-bold shadow-sm mb-3">
                            Registrar e Entrar no Sistema
                        </button>
                    </form>
                    
                    <div class="text-center mt-3">
                        <p class="small text-muted mb-0">Já tem uma conta? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-success fw-medium text-decoration-none">Entre aqui</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        function alternarVisibilidadeSenha(inputId, iconId) {
            var input = document.getElementById(inputId);
            var icon = document.getElementById(iconId);
            
            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash"); // Muda para o ícone com um traço
            } else {
                input.type = "password";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye"); // Volta para o olho normal
            }
        }

        document.getElementById('btnToggleSenha').addEventListener('click', function () {
            alternarVisibilidadeSenha('senhaInput', 'iconSenha');
        });

        document.getElementById('btnToggleConfirma').addEventListener('click', function () {
            alternarVisibilidadeSenha('confirmaSenhaInput', 'iconConfirma');
        });
    </script>
}